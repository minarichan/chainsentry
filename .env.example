# Required for Etherscan-verified source and on-chain tx stats (free at https://etherscan.io/apis)
# API V2: requests go to https://api.etherscan.io/v2/api with chainid
ETHERSCAN_API_KEY=
# Etherscan V2 chainid used when the UI does not send chain_id (CLI default)
ETHERSCAN_CHAIN_ID=1

# Optional Blockscout v2 base — only overrides Ethereum (chain 1)
# BLOCKSCOUT_API_URL=

# RPC endpoints for on-chain snapshots (public defaults work for demos)
ETH_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ARB_RPC_URL=https://arb1.arbitrum.io/rpc

# Public origin of this process.
# Hash routes stay in the browser: https://HOST/#/  https://HOST/#/report/<id>
PUBLIC_URL=https://chainsentry.dev

# Comma-separated extra CORS origins (not required when UI and API are the same host)
CORS_ORIGINS=

# API
API_HOST=0.0.0.0
API_PORT=8000

# SQLite scan store (shareable report ids)
# SCAN_DB_PATH=data/scans.sqlite

# Max seconds for one scan (solc download + compile + detectors)
SCAN_TIMEOUT_SEC=120
