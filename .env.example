# Required for Etherscan-verified source and on-chain tx stats (free at https://etherscan.io/apis)
# API V2: requests go to https://api.etherscan.io/v2/api with chainid
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=1

# Optional Blockscout v2 base (default: https://eth.blockscout.com/api/v2/smart-contracts)
# BLOCKSCOUT_API_URL=

# RPC endpoint for on-chain analysis (public mainnet RPC works for demos)
ETH_RPC_URL=https://eth.llamarpc.com

# API
API_HOST=0.0.0.0
API_PORT=8000
