# Copy to deploy/secrets.env on this PC. That file is gitignored.
# View anytime:  powershell -File deploy/show-secrets.ps1
# Do not paste these values into git, chat, or screenshots.

# InterServer VPS
VPS_HOST=203.0.113.10
VPS_USER=root
VPS_PORT=22
SSH_KEY_PATH=C:\Users\Administrator\.ssh\chainsentry_ed25519

# Used only for the first login to install the SSH key. Clear this after harden-ssh.sh.
VPS_PASSWORD=

# Where the repo lives on the VPS
REMOTE_DIR=/opt/chainsentry

# Public origin (ENS url record uses this, no hash).
#   PUBLIC_URL/#/
#   PUBLIC_URL/#/report/<id>
PUBLIC_URL=https://chainsentry.dev

# Optional: Cloudflare named-tunnel token from Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Pinata JWT (pinFileToIPFS) for deploy/pin-ens-gateway.ps1
PINATA_JWT=

# Local backup folder on this PC
BACKUP_DIR=C:\Users\Administrator\Documents\ChainSentry-backup
